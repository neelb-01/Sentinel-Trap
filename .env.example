# Copy to .env and set a real password before `make up`.
# .env is gitignored; .env.example is not.

POSTGRES_DB=sentineltrap
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me

# Decoy subnet. Must match scripts/honeynet-egress.sh and the compose ipam block.
ST_HONEYNET_SUBNET=172.30.0.0/24

# Tarpit: delay applied to repeat offenders, in seconds.
ST_TARPIT_MIN_SECONDS=3
ST_TARPIT_MAX_SECONDS=8

# DEBUG turns on per-batch logging in the pipeline.
ST_LOG_LEVEL=INFO
